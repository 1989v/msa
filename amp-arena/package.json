{
  "name": "amp-arena",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client"
  ],
  "scripts": {
    "dev:relay": "node tools/dev-relay.mjs",
    "dev:client": "npm -w client run dev",
    "dev": "npm run dev:relay & npm run dev:client",
    "build": "npm -w client run build",
    "build:games": "ARENA_BASE=/games/arena/ ARENA_OUT=dist-games npm -w client run build",
    "typecheck": "tsc -p shared --noEmit && tsc -p client --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "ws": "^8.21.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
