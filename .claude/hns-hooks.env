# hns 훅 설정 (ai/plugins/hns/templates/hooks/README.md). 환경변수가 있으면 그것이 우선.
HNS_HOOK_TIER=enforce
# 바뀐 파일이 속한 모듈만 컴파일 (Kotlin: compileKotlin+compileTestKotlin, portal-fe: tsc -b)
HNS_COMPILE_CMD=".claude/hooks/hns/compile-changed.sh"
# 프로젝트에 ktlint/detekt 가 없어 편집 후 린트는 끈다
HNS_LINT_CMD=""
HNS_LINT_GLOB="*.kt *.ts *.tsx"
