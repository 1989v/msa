{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "query": { "type": "keyword" },
      "normalized": { "type": "keyword" },
      "modelRef": { "type": "keyword" },
      "dim": { "type": "short" },
      "vector": { "type": "binary" },
      "source": { "type": "keyword" },
      "updatedAt": { "type": "date", "format": "yyyy-MM-dd'T'HH:mm:ss" }
    }
  }
}
