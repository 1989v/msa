        "type": "keyword"
      },
      "membership": {
        "type": "keyword"
      },
      "marketName": {
        "type": "keyword"
      },
      "storeId": {
        "type": "long"
      },
      "zoneId": {
        "type": "long"
      },
      "pathId": {
        "type": "long"
      },
      "name": {
        "type": "text",
        "analyzer": "market_ko"
      },
      "items": {
        "type": "text",
        "analyzer": "market_ko"
      },
      "categoryMajor": {
        "type": "text",
        "analyzer": "market_ko"
      },
      "categoryMid": {
        "type": "text",
