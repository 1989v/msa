      <Item class="ModuleScript" referent="RBX0454">
        <Properties>
          <string name="Name">ChargeInput</string>
          <ProtectedString name="Source">-- Identity-based ownership prevents the movement thumb from releasing held jump.
local ChargeInput={}
function ChargeInput.begin(s,input)
    if s.owner~=nil or input==nil then return false end
    s.owner=input
    return true
end
function ChargeInput.finish(s,input)
    if s.owner==nil or s.owner~=input then return false end
    s.owner=nil
    return true
end
function ChargeInput.cancel(s)
    local active=s.owner~=nil
    s.owner=nil
    return active
end
return ChargeInput
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0455">
        <Properties>
          <string name="Name">Course</string>
          <ProtectedString name="Source">-- Roblox-native interpretation. Original export remains optional design reference only.
local Generator,Jump
if script then
    Generator=require(script.Parent.Generator);Jump=require(script.Parent.Jump)
else
    Generator=require("./Generator");Jump=require("./Jump")
end
local Course=Generator.build(20261028,"Normal",Jump.solve)
Course.version=2;Course.scale=4
Course.palette={body=Generator.body,asphalt={.129,.137,.161}}
local byId={}
for _,p in Course.platforms do byId[p.id]=p end
local legacyNames={"Start","Crate","Awning","Exterior","Vent","Balcony","Roof","Tank","Finish"}
Course.legacy={}
for i,id in legacyNames do Course.legacy[id]={id=id,x=(i-1)*12,y=(i-1)*6,z=0,sx=12,sz=12,depth=4,region=math.min(3,math.floor((i-1)/3)+1)} end
function Course.platform(id) return byId[id] end
function Course.resolve(target)
    if target.courseVersion==Course.version then return byId[target.platformId] end
    if target.courseVersion==1 then return Course.legacy[target.platformId] end
    return nil
end
function Course.resume(alt)
    local found=byId.Start
    for _,id in Course.path do local p=byId[id];if p.y&gt;alt then break end;found=p end
    return found
end
function Course.look(y)
    local keys=Course.environment
    local index=1
    for i=1,#keys do if y&gt;=keys[i].y then index=i end end
    local a,b=keys[index],keys[math.min(index+1,#keys)]
    local t=b.y&gt;a.y and math.clamp((y-a.y)/(b.y-a.y),0,1) or 0
    local function blend(x,z) return x+(z-x)*t end
    return {sky={blend(a.sky[1],b.sky[1]),blend(a.sky[2],b.sky[2]),blend(a.sky[3],b.sky[3])},
        fogStart=blend(a.fogStart,b.fogStart),fogEnd=blend(a.fogEnd,b.fogEnd),sunPower=blend(a.sunPower,b.sunPower),
        gravity=a.gravity,wind={0,0,0}}
end
return Course
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0456">
        <Properties>
          <string name="Name">Fall</string>
          <ProtectedString name="Source">-- Character epochs and offer serials are server-owned. Death carries only the snapshot.
local Fall = {}
function Fall.new()
    return { epoch=0, serial=0, safeRegion=1, safeId="Start", safeY=0, peak=0 }
end
function Fall.clear(s)
    s.serial += 1
    s.snapshot = nil
    s.offer = nil
    s.suppressed = true
end
function Fall.character(s, preserveDeath)
    s.epoch += 1
    s.serial += 1
    s.offer = nil
    s.safeRegion, s.safeId, s.safeY, s.peak = 1, "Start", 0, 0
    if not preserveDeath then s.snapshot = nil end
    if s.snapshot then
        s.offer = { token=s.serial, epoch=s.epoch, region=s.snapshot.region, platformId=s.snapshot.platformId }
    end
end
function Fall.land(s, platform)
    if not platform then return end
    -- Only a new ascent above the departure clears the original descent snapshot.
    if s.snapshot and platform.y &gt; s.snapshot.y + 1 then Fall.clear(s) end
    s.safeRegion, s.safeId, s.safeY = platform.region, platform.id, platform.y
    s.suppressed=false
    s.peak = math.max(s.peak, platform.y)
end
function Fall.sample(s, y, descending)
    if descending and not s.suppressed and not s.snapshot and s.safeY &gt; 0 then
        s.snapshot = { region=s.safeRegion, platformId=s.safeId, y=s.safeY }
    end
    if s.snapshot and s.snapshot.y - y &gt;= 10 and not s.offer then
        s.serial += 1
        s.offer = { token=s.serial, epoch=s.epoch, region=s.snapshot.region, platformId=s.snapshot.platformId }
    end
end
function Fall.death(s)
    if not s.suppressed and not s.snapshot and s.safeY &gt; 0 then s.snapshot={region=s.safeRegion,platformId=s.safeId,y=s.safeY} end
    s.offer=nil
end
function Fall.valid(s, token, epoch)
    return s.offer ~= nil and s.offer.token == token and s.offer.epoch == epoch and s.epoch == epoch
end
return Fall
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0457">
        <Properties>
          <string name="Name">Generator</string>
          <ProtectedString name="Source">-- Roblox adaptation: deterministic native urban route, not a coordinate copy of Unity.
-- Pure Luau; no Roblox APIs, Unity, SDK, or external assets required.
local Generator={}
Generator.names={"뒷골목","외벽","옥상","마천루","공사장","성층권","블랙홀"}
Generator.body={{.239,.235,.259},{.404,.310,.286},{.549,.553,.545},{.353,.451,.510},{.686,.529,.239},{.353,.384,.447},{.427,.451,.510}}
Generator.sky={{.055,.063,.106},{.180,.196,.310},{.451,.541,.694},{.565,.702,.878},{.612,.741,.918},{.176,.263,.427},{.016,.020,.043}}
local function chord(p,x,z)
    return math.min(math.abs(x)&gt;0.0001 and p.sx/2/math.abs(x) or math.huge,math.abs(z)&gt;0.0001 and p.sz/2/math.abs(z) or math.huge)
end
function Generator.build(seed,hardness,solve)
    local random=seed%2147483647
    local function rng() random=random*48271%2147483647;return random/2147483647 end
    local result={seed=seed,hardness=hardness,platforms={},path={},links={},regions={},environment={},decor={}}
    local platforms=result.platforms
    platforms[1]={id="Start",x=0,y=0,z=-8,sx=1040,sz=1040,depth=4,region=1,kind="Solid",mover=0,grade=0,shape="Part",label="지면"}
    result.movers={}
    local heading=0
    local labels={{"컨테이너","실외기","차양","창틀"},{"배수관","비상계단","외벽 난간"},{"환기구","물탱크 받침","옥상 테라스"},{"유리 보행대","곤돌라","정비 발판"},{"철골 빔","비계","크레인 받침"},{"통신 잔해","안테나 받침","위성 판"},{"우주 잔해","관측판","블랙홀 접근대"}}
    for region=1,7 do
        local floor=platforms[#platforms].y
        result.regions[region]={name=Generator.names[region],y=floor}
        result.environment[region]={y=floor,sky=Generator.sky[region],fogStart=region==1 and 56 or 200,fogEnd=300+region*100,sunPower=region==1 and .32 or 1,gravity=region&gt;=7 and .8 or region&gt;=6 and .9 or 1,wind={0,0,0}}
        for step=1,28 do
            local previous=platforms[#platforms]
            local size=16+rng()*6
            local p={id=string.format("R%d_%02d",region,step),region=region,kind="Solid",shape="Part",sx=size,sz=16+rng()*6,depth=3+rng()*5,mover=0,grade=0,onPath=true,label=labels[region][(step-1)%#labels[region]+1]}
            if region==3 and step%9==5 then p.kind="Crumble";p.label="낡은 팔레트" end
            if (region==4 or region==7) and step%9==6 then p.kind="Mover";p.label=region==4 and "곤돌라" or "떠도는 잔해" end
            if region==5 and step%6==4 then p.kind="Ice";p.label="젖은 철골" end
            if region==6 and step%5==3 then p.kind="Ice";p.label="성에 낀 통신판" end
            if (region==2 or region==3 or region==5) and step%14==7 then p.kind="Wall";p.label="배수관 등반벽";p.depth=36 end
            if step%11==3 then p.sx=30;p.sz=12;p.label="긴 빔" end
            if step%13==2 then p.sx=26;p.sz=26;p.label="휴식 테라스" end
            local rise=8+rng()*4
            if previous.kind=="Crumble" then rise=5;end
            if p.kind=="Wall" then rise=24 end
            if #platforms==1 then rise=10.4;heading=0 end
            local dx,dz=math.sin(heading),math.cos(heading)
            local ac,bc=chord(previous,dx,dz),chord(p,dx,dz)
            local gap=hardness=="Hard" and 9 or 6
            if previous.kind=="Crumble" then gap=3 end
            local gs=result.environment[region].gravity
            local level,back,air=nil,nil,nil
            if p.kind=="Wall" then
                level=3;back=0;air=.35
            else
                for attempt=1,12 do
                    for l=1,previous.kind=="Crumble" and 3 or 5 do
                        local b,t=solve(l,rise,gap,bc*2,ac*2-2.4,gs,0)
                        local safe=b~=nil
                        for _,offset in {previous.kind=="Mover" and 1 or 0,p.kind=="Mover" and -1 or 0} do
                            if not solve(l,rise+offset,gap,bc*2,ac*2-2.4,gs,0) then safe=false end
                        end
                        if safe then level=l;back=b;air=t;break end
                    end
                    if level then break end
                    gap=math.max(1,gap*.8);rise=math.max(4,rise-.5)
                end
                assert(level,"native route link cannot be solved")
            end
            local distance=ac+gap+bc
            if #platforms==1 then p.x=0;p.z=13.6 else p.x=previous.x+dx*distance;p.z=previous.z+dz*distance end
            p.y=previous.y+rise
            if #platforms&lt;=4 then p.depth=p.y end
            if p.kind=="Mover" then
                -- Vertical motion only: horizontal route remains legible. Test the highest endpoint.
                result.movers[#result.movers+1]={a={p.x,p.y-1,p.z},b={p.x,p.y,p.z},period=5+2*rng(),phase=rng()}
                p.mover=#result.movers
            end
            platforms[#platforms+1]=p;result.path[#result.path+1]=p.id
            if previous.id~="Start" then result.links[#result.links+1]={source=previous.id,target=p.id,level=level,back=back,air=air,gravityScale=gs,dir={dx,0,dz},gap=gap} end
            heading+=.105+rng()*.05
        end
    end
    result.summit=platforms[#platforms].y
    local function decor(x,y,z,sx,sy,sz,color,shape)
        table.insert(result.decor,{x=x,y=y,z=z,sx=sx,sy=sy,sz=sz,color=color,shape=shape or "Part"})
    end
    -- A real street entrance and grounded building masses frame the first decisions.
    for _,side in {-1,1} do
        decor(side*38,28,20,18,56,46,Generator.body[1])
        for row=1,4 do decor(side*28.8,row*10,12,0.4,4,5,{.95,.76,.29}) end
        decor(side*27,18,5,1,36,1,{.514,.318,.208},"TrussPart")
    end
    for i,p in platforms do
        if p.id=="Start" then continue end
        -- Device silhouettes stay outside the landing footprint and never mask collision.
        if p.kind=="Wall" then
            decor(p.x,p.y-p.depth/2,p.z-p.sz/2-.5,1.5,p.depth,1,{.62,.66,.72},"TrussPart")
        elseif p.kind=="Mover" then
            decor(p.x+p.sx/2+1,p.y+12,p.z,0.5,24,0.5,{.62,.66,.72})
        elseif p.kind=="Crumble" then
            for r=1,3 do decor(p.x+(r-2)*4,p.y-.2,p.z,0.25,.3,p.sz,{.851,.443,.192}) end
        elseif p.kind=="Ice" then
            decor(p.x,p.y+.02,p.z,p.sx*.7,.04,p.sz*.7,{1,1,1})
        elseif p.region==1 then
            for rib=1,3 do decor(p.x+(rib-2)*4,p.y-p.depth/2,p.z-p.sz/2-.1,.3,p.depth,.25,{.427,.416,.447}) end
        elseif p.region==2 then
            decor(p.x,p.y-1,p.z+p.sz/2+1,p.sx,2,2,{.514,.318,.208})
        elseif p.region==3 and i%3==0 then
            decor(p.x+p.sx/2+3,p.y+3,p.z,5,6,5,{.62,.66,.72})
        elseif p.region==4 and i%4==0 then
            decor(p.x+p.sx/2+18,p.y-20,p.z,12,70,26,{.396,.549,.639})
        elseif p.region==5 then
            decor(p.x,p.y-10,p.z,2,20,2,{.686,.529,.239},"TrussPart")
        elseif p.region==6 and i%3==0 then
            decor(p.x+p.sx/2+2,p.y+8,p.z,.5,16,.5,{.62,.66,.72})
        end
    end
    local last=platforms[#platforms]
    -- The black-hole goal is above the summit; collision remains on the actual landing platform.
    decor(last.x,last.y+65,last.z+45,70,70,70,{.008,.008,.016},"Ball")
    for i=1,20 do
        local angle=i*math.pi/10
        decor(last.x+math.cos(angle)*47,last.y+65+math.sin(angle)*47,last.z+45,9,9,2,{1,.667,.298})
    end
    return result
end
return Generator
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0458">
        <Properties>
          <string name="Name">HudLayout</string>
          <ProtectedString name="Source">-- Coordinates use the ScreenGui device-safe content rectangle, in pixels.
local HudLayout={}
function HudLayout.compute(width,height,modal)
    local compact=height&lt;520
    local function rect(x,y,w,h) return {x=x,y=y,w=w,h=h} end
    local result={
        compact=compact,modal=modal,
        status=rect(8,8,width-16,compact and 40 or 72),
        meter=rect(8,compact and 56 or 88,math.min(240,width-96),compact and 28 or 40),
        help=rect(8,132,width-16,36),
        jump=rect(width-112,height-(compact and 216 or 240),96,compact and 56 or 72),
        grab=rect(width-184,height-(compact and 216 or 240),64,compact and 56 or 72),
        run=rect(width-72,compact and 56 or 88,64,44),
        restart=rect(width-144,height-(compact and 148 or 304),128,48),
        panel=rect(16,math.max(compact and 56 or 176,math.floor((height-180)/2)),width-32,180),
    }
    local p=result.panel
    result.use=rect(p.x+8,p.y+72,p.w/2-12,48)
    result.dismiss=rect(p.x+p.w/2+4,p.y+72,p.w/2-12,48)
    result.buy=rect(p.x+8,p.y+128,p.w-16,48)
    return result
end
function HudLayout.status(data,compact)
    if data.error then
        return "저장 오류 · 재시도 중\n"..string.sub(tostring(data.error),1,compact and 32 or 90)
    end
    if compact then
        return string.format("%s · 고도 %.0f / 최고 %.0f\n%s 부활권: %d%s",data.region,data.current/4,data.best/4,data.test and "테스트" or "보유",data.balance,data.finished and " · 정상 도달!" or string.format(" · 낙하 %d회",data.falls or 0)..(data.locked and " · 복구 중" or ""))
    end
    return string.format("인피니티 스탭 / %s\n고도 %.0f · 최고 %.0f · %s 부활권: %d%s",data.region,data.current/4,data.best/4,data.test and "테스트" or "보유",data.balance,data.finished and " · 정상 도달!" or string.format(" · 낙하 %d회",data.falls or 0)..(data.locked and " · 안전 복구 중" or ""))
end
return HudLayout
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0459">
        <Properties>
          <string name="Name">Jump</string>
          <ProtectedString name="Source">-- Source reference: Leap.cs. Four studs per source unit; levels are 1-based here.
local Jump = { Gravity = 104, HoldStep = 0.12, MaxHold = 1.2 }
function Jump.finite(n)
    return type(n) == "number" and n == n and math.abs(n) &lt; math.huge
end
function Jump.level(seconds)
    return math.clamp(math.floor(math.clamp(seconds, 0, Jump.MaxHold) / Jump.HoldStep + 1e-7) + 1, 1, 5)
end
function Jump.speeds(level)
    local t = (math.clamp(level, 1, 5) - 1) / 4
    return 30 + 34 * t, 6 + 34 * t
end
function Jump.direction(x, z)
    if not Jump.finite(x) or not Jump.finite(z) then return nil end
    local length = math.sqrt(x*x + z*z)
    if length &lt; 0.01 or length &gt; 1.1 then return nil end
    return x / length, z / length
end
function Jump.release(started, now, grounded, x, z)
    if not started or not grounded or not Jump.finite(now) or now &lt; started then return nil end
    local dx, dz = Jump.direction(x, z)
    if not dx then return nil end
    local level = Jump.level(now - started)
    local vy, vx = Jump.speeds(level)
    return { x = dx * vx, y = vy, z = dz * vx, level = level }
end
-- Descending intersection with target height; used to verify authored route.
function Jump.landing(level, rise)
    local vy, vx = Jump.speeds(level)
    local disc = vy*vy - 2*Jump.Gravity*rise
    if disc &lt; 0 then return nil end
    local seconds = (vy + math.sqrt(disc)) / Jump.Gravity
    return vx * seconds, seconds
end
-- Leap.Solve, scaled x4. Checks front body clearance and both landing margins.
function Jump.solve(level,rise,gap,targetSpan,backSpan,gravityScale,wind)
    local g=Jump.Gravity*math.max(0.1,gravityScale)
    local vy,vx=Jump.speeds(level);vx+=wind
    if vx&lt;1.2 then return nil end
    local disc=vy*vy-2*g*rise
    if disc&lt;0 then return nil end
    local air=(vy+math.sqrt(disc))/g;local land=vx*air
    local lo=math.max(0,land-gap-targetSpan+2.8-0.04)
    local hi=math.min(backSpan,land-gap-2.4)
    if lo&gt;hi then return nil end
    local center=math.clamp(land-gap-targetSpan*0.5,lo,hi)
    for _,back in {center,hi,(center+hi)*0.5,lo,(lo+center)*0.5} do
        local te=math.max(0.01,(back+gap-1.8)/vx)
        if vy*te-0.5*g*te*te&gt;=rise+2.2 then return back,air end
    end
    return nil
end
return Jump
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0460">
        <Properties>
          <string name="Name">Terrain</string>
          <ProtectedString name="Source">-- Original KgdMover.At / Tower.StandOn / Tower.Tick scalar rules.
local Terrain={}
function Terrain.mover(m,time)
    local t=0.5-0.5*math.cos((time/math.max(0.1,m.period)+m.phase)*math.pi*2)
    return m.a[1]+(m.b[1]-m.a[1])*t,m.a[2]+(m.b[2]-m.a[2])*t,m.a[3]+(m.b[3]-m.a[3])*t
end
function Terrain.stand(c,dt)
    c=c or {stage=0,t=0}
    if c.stage==0 then c.t+=dt;c.stood=true;if c.t&gt;=0.55 then c.stage=1;c.t=0.6 end end
    return c
end
function Terrain.tick(c,dt)
    if c.stage==0 then
        if not c.stood then c.t=math.max(0,c.t-dt*2) end
        c.stood=false
        if c.t==0 then return nil end
    else
        c.t-=dt
        if c.t&lt;=0 then
            if c.stage==1 then c.stage=2;c.t=8 else return nil end
        end
    end
    return c
end
return Terrain
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0461">
        <Properties>
          <string name="Name">Theme</string>
          <ProtectedString name="Source">-- Central mapping from root DESIGN.md §12 (k-heritage arcade).
-- RGB tuples keep this module executable outside Roblox. No UI/world inline colors.
return {
    ink={10,10,10}, giwa={29,29,31}, hanji={249,248,242},
    yeonji={162,35,29}, ocher={179,139,109}, celadon={43,75,99},
    textSize=16, titleSize=24, touch=48, gap=8, radius=4,
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0462">
        <Properties>
          <string name="Name">Traverse</string>
          <ProtectedString name="Source">-- Climber.Tuning + KgdTraverse, source units converted at the boundary (x4).
-- Roblox collision/ledge adapter remains subject to Studio runtime verification.
local Traverse={Walk=22,Run=34.4,ChargeScale=0.35,RunJumpBonus=0.18,
    TerminalFall=160,StaminaMax=100,HangDrain=11,LedgeCost=12,
    ClimbSpeed=12.8,LedgeReach=2,LedgeMinRise=2,LedgeMaxRise=7.8,PullTime=0.34,
    Regain=24,RegainDelay=0.5}
function Traverse.walkSpeed(running,charging)
    return (running and Traverse.Run or Traverse.Walk)*(charging and Traverse.ChargeScale or 1)
end
function Traverse.air(x,y,z,dx,dz,dt,charged)
    if not charged then
        local t=math.min(1,3*dt)
        x+=(dx*Traverse.Run-x)*t;z+=(dz*Traverse.Run-z)*t
    end
    return x,math.max(-Traverse.TerminalFall,y),z
end
function Traverse.grab(stamina,rise)
    if rise&lt;Traverse.LedgeMinRise or rise&gt;Traverse.LedgeMaxRise or stamina&lt;Traverse.LedgeCost then return nil end
    return stamina-Traverse.LedgeCost
end
function Traverse.drain(stamina,dt) return math.max(0,stamina-Traverse.HangDrain*dt) end
return Traverse
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX0449">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX0450">
      <Properties>
        <string name="Name">InfinityStep</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX0463">
        <Properties>
          <string name="Name">Delivery</string>
          <ProtectedString name="Source">-- Placement/freeze boundaries are synchronous. Only atomic storage calls may yield.
local Delivery = {}
function Delivery.run(ledger, key, record, character, current, freeze, place)
    local pending=record.pending
    if not pending then return record end
    if current()~=character then return nil,"Character replaced; delivery retained" end
    -- Never trust a cached pending record: acquire ownership of the live operation.
    local owned,claimError=ledger:claim(key,pending.id)
    if not owned then return nil,claimError end
    pending=owned.pending
    if current()~=character then return nil,"Character replaced during claim; delivery retained" end
    freeze(character,true)
    local ok, delivered=pcall(place,character,pending.target)
    if not ok or not delivered then return nil,"Placement failed; delivery retained" end
    if current()~=character then return nil,"Character replaced; delivery retained" end
    local ack,err=ledger:ack(key,pending.id,function() return current()==character end)
    if not ack then return nil,err end
    if ack.pending then return nil,"Delivery pending" end
    if current()~=character then
        -- UpdateAsync may commit and then yield before returning. Hand the completed
        -- delivery to the replacement before unlocking; never teleport the stale body.
        local replacement=current()
        if not replacement then return nil,"Waiting for replacement character",pending end
        freeze(replacement,true)
        local placed,safe=pcall(place,replacement,pending.target)
        if not placed or not safe or current()~=replacement then
            return nil,"Replacement placement pending",pending
        end
        freeze(replacement,false)
    else freeze(character,false) end
    return ack
end
return Delivery
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0464">
        <Properties>
          <string name="Name">Ingress</string>
          <ProtectedString name="Source">local Ingress={}
function Ingress.allow(s,now)
    local elapsed=math.max(0,now-(s.ingressAt or now))
    s.ingressAt=now
    s.tokens=math.min(20,(s.tokens or 20)+elapsed*15)
    if s.tokens&lt;1 then return false end
    s.tokens-=1
    return true
end
return Ingress
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0465">
        <Properties>
          <string name="Name">Ledger</string>
          <ProtectedString name="Source">-- update(key, transform) must be atomic (DataStore UpdateAsync in live adapter).
-- Never cache and save an entire record. Transforms may be retried by Roblox.
local Ledger = {}
Ledger.__index = Ledger
local function fresh(old)
    if old == nil then return {version=1,balance=0,receipts={},uses={}} end
    assert(type(old)=="table" and old.version==1 and type(old.balance)=="number"
        and old.balance&gt;=0 and old.balance%1==0 and type(old.receipts)=="table"
        and type(old.uses)=="table", "Invalid stored record; refusing defaults")
    local copy = table.clone(old)
    copy.receipts, copy.uses = table.clone(old.receipts), table.clone(old.uses)
    if old.pending then copy.pending=table.clone(old.pending) end
    return copy
end
function Ledger.new(update, validTarget, clock, owner)
    return setmetatable({update=update, validTarget=validTarget, clock=clock or os.time, owner=owner or "local"}, Ledger)
end
function Ledger:mutate(key, transform)
    local ok, value = pcall(self.update, tostring(key), function(old)
        return transform(fresh(old))
    end)
    if not ok then return nil, tostring(value) end
    return value
end
function Ledger:load(key)
    return self:mutate(key, function(r) return r end)
end
function Ledger:grant(key, purchaseId)
    if type(purchaseId)~="string" or #purchaseId==0 then return nil,"Invalid receipt" end
    return self:mutate(key, function(r)
        if not r.receipts[purchaseId] then
            r.receipts[purchaseId]=true
            r.balance+=1
        end
        return r
    end)
end
function Ledger:reserve(key, operation, target)
    if type(operation)~="string" or #operation==0 or type(target)~="table" or not self.validTarget(target) then
        return nil,"Invalid operation or authored platform"
    end
    local r, err = self:mutate(key,function(record)
        if record.pending or record.uses[operation] or record.balance&lt;=0 then return record end
        record.balance-=1
        record.uses[operation]=true
        record.pending={id=operation,target=table.clone(target),owner=self.owner,leaseUntil=self.clock()+30}
        return record
    end)
    if not r then return nil,err end
    if not r.pending or r.pending.id~=operation then return nil,"Another delivery pending, used operation, or no tickets" end
    return r
end
function Ledger:claim(key, operation)
    local r,err=self:mutate(key,function(record)
        local p=record.pending
        if p and p.id==operation and (p.owner==self.owner or (p.leaseUntil or 0)&lt;self.clock()) then
            p.owner=self.owner;p.leaseUntil=self.clock()+30
        end
        return record
    end)
    if not r then return nil,err end
    local p=r.pending
    if not p or p.id~=operation or p.owner~=self.owner or p.leaseUntil&lt;=self.clock() then
        return nil,"Delivery owned by another session, expired or completed"
    end
    return r
end
function Ledger:ack(key, operation, stillCurrent)
    return self:mutate(key,function(r)
        if r.pending and r.pending.id==operation and r.pending.owner==self.owner and r.pending.leaseUntil&gt;self.clock() and (not stillCurrent or stillCurrent()) then r.pending=nil end
        return r
    end)
end
return Ledger
</ProtectedString>
        </Properties>
