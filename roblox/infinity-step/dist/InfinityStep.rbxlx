      <Item class="Script" referent="RBX0466">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Replicated=game:GetService("ReplicatedStorage")
local DataStores=game:GetService("DataStoreService")
local Marketplace=game:GetService("MarketplaceService")
local Http=game:GetService("HttpService")
local Shared=Replicated:WaitForChild("InfinityStep")
local Jump=require(Shared.Jump)
local Traverse=require(Shared.Traverse)
local Course=require(Shared.Course)
local Fall=require(Shared.Fall)
local Ledger=require(script.Parent.Ledger)
local Delivery=require(script.Parent.Delivery)
local Receipt=require(script.Parent.Receipt)
local Progress=require(script.Parent.Progress)
local Recovery=require(script.Parent.Recovery)
local World=require(script.Parent.World)
local world=World.new(Course,workspace:WaitForChild("Course"))
local Ingress=require(script.Parent.Ingress)
local PRODUCT_ID=0 -- Configure only after private published receipt verification.
local STUDIO=Run:IsStudio()
local remote=Shared:WaitForChild("Action")
local state=Shared:WaitForChild("State")
local store=not STUDIO and DataStores:GetDataStore("InfinityStepTickets_v1") or nil
local progressStore=not STUDIO and DataStores:GetDataStore("InfinityStepProgress_v2") or nil
local progressMemory={}
local function updateProgress(key,transform)
    if STUDIO then
        local updated=transform(progressMemory[key])
        if updated~=nil then progressMemory[key]=updated end
        return updated
    end
    return progressStore:UpdateAsync(key,transform)
end
local memory={}
local ledger=Ledger.new(function(key,transform)
    if STUDIO then
        if not memory[key] then memory[key]={version=1,balance=3,receipts={},uses={}} end
        memory[key]=transform(memory[key])
        return memory[key]
    end
    return store:UpdateAsync(key,transform)
end,function(target) return Course.resolve(target)~=nil end,os.time,Http:GenerateGUID(false))
local sessions={}
local productPrice=nil
if not STUDIO and PRODUCT_ID&gt;0 then
    task.spawn(function()
        local ok,info=pcall(Marketplace.GetProductInfo,Marketplace,PRODUCT_ID,Enum.InfoType.Product)
        if ok and type(info.PriceInRobux)=="number" and info.IsForSale~=false then productPrice=info.PriceInRobux end
    end)
end
workspace.Gravity=Jump.Gravity
local function rootOf(character) return character and character:FindFirstChild("HumanoidRootPart") end
local function freeze(character,enabled)
    local root=rootOf(character)
    if root then root.Anchored=enabled; root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero end
end
local legacyPads={}
local function place(character,destination)
    local target=Course.resolve(destination)
    local root=rootOf(character)
    if not target or not root or not character.Parent then return false end
    local x,y,z=target.x,target.y,target.z
    if destination.courseVersion==Course.version and target.id~="Start" then
        local parts=world.parts[target.id]
        if not parts or not parts[1].CanCollide then return false end
        if target.mover&gt;0 then x=parts[1].Position.X;y=parts[1].Position.Y+target.depth/2;z=parts[1].Position.Z end
        local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={character}
        for _,part in workspace:GetPartBoundsInBox(CFrame.new(x,y+5,z),Vector3.new(3,7,3),params) do
            if part.CanCollide then return false end
        end
    end
    if destination.courseVersion==1 then
        -- Exact legacy target is materialized only for a durable v1 obligation.
        -- Refuse overlapping terrain and retain the pending right; never substitute a target.
        local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={character}
        local bounds=workspace:GetPartBoundsInBox(CFrame.new(target.x,target.y+5,target.z),Vector3.new(4,7,4),params)
        for _,part in bounds do if part.CanCollide then return false end end
        local pad=legacyPads[target.id]
        if not pad or not pad.Parent then
            pad=Instance.new("Part");pad.Name="LegacyDelivery_"..target.id
            pad:SetAttribute("LegacyDelivery",true);pad.Anchored=true;pad.Size=Vector3.new(12,1,12)
            pad.Position=Vector3.new(target.x,target.y-0.5,target.z);pad.Parent=workspace;legacyPads[target.id]=pad
            task.delay(120,function() if pad.Parent then pad:Destroy() end end)
        end
    end
    character:PivotTo(CFrame.new(x,y+5,z))
    root.AssemblyLinearVelocity=Vector3.zero
    root.AssemblyAngularVelocity=Vector3.zero
    return true
end
local function notify(player,s)
    if not player.Parent then return end
    state:FireClient(player,{
        epoch=s.fall.epoch,region=Course.regions[s.fall.safeRegion].name,falls=s.falls or 0,stamina=s.stamina or 100,hanging=s.hang~=nil,climbing=s.climb~=nil,finished=s.finished==true,
        current=s.height or 0,best=s.best or 0,balance=s.record and s.record.balance or 0,
        offer=s.fall.offer,test=STUDIO,error=s.error,
        locked=s.locked,purchase=not STUDIO and s.loaded and PRODUCT_ID&gt;0 and productPrice~=nil,
        product=PRODUCT_ID,price=productPrice,
    })
end
local function recover(player,s,character)
    if s.busy then return end
    s.busy=true
    if s.handoff then
        -- ACK committed before its yielding call returned to a replacement character.
        -- Complete the session-local obligation before any new progress/debit.
        if s.character~=character or not place(character,s.handoff.target) then s.busy=false;return end
        s.handoff=nil
    end
    if not s.progressLoaded then
        local run,progressError=s.progress:load(player.UserId)
        if s.character~=character then s.busy=false;return end
        if not run then s.error=progressError;s.busy=false;notify(player,s);return end
        s.progressLoaded=true;s.savedRun=run;s.best=run.best;s.falls=run.falls;s.elapsed=run.elapsed or 0;s.summitSec=run.summitSec or 0;s.finished=s.summitSec&gt;0
    end
    local record,err=ledger:load(player.UserId)
    if s.character~=character then s.busy=false; return end
    if record then
        s.loaded=true; s.record=record
        if record.pending then
            s.savedRun=nil
            s.locked=true
            record,err,s.handoff=Delivery.run(ledger,player.UserId,record,character,function() return s.character end,freeze,place)
            if record then s.record=record; Fall.clear(s.fall) end
        else
            if s.savedRun then
                local target=Course.resume(s.savedRun.alt)
                if not place(character,{courseVersion=Course.version,platformId=target.id}) then s.busy=false;return end
                s.savedRun=nil
            end
            freeze(character,false)
        end
    end
    Recovery.finish(s,character,record,err)
    notify(player,s)
end
local function ground(character,root)
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={character}
    local hit=workspace:Raycast(root.Position,Vector3.new(0,-4.2,0),params)
    if hit and hit.Normal.Y&gt;0.8 then return hit.Instance end
    return nil
end
local function detach(s,root)
    s.hang=nil;s.climb=nil;s.pull=nil;s.cool=os.clock()+0.25
    root.Anchored=false;s.character:SetAttribute("InfinityHanging",false)
end
local function surface(s,root,direction)
    if direction.Magnitude&lt;0.01 then return nil end
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={s.character}
    local hit=workspace:Raycast(root.Position-Vector3.new(0,1.1,0),direction.Unit*5.7,params)
    local p=hit and Course.platform(hit.Instance.Name)
    if not p or not hit.Instance.CanCollide or math.abs(hit.Normal.Y)&gt;0.3 then return nil end
    local top=hit.Instance.Position.Y+hit.Instance.Size.Y/2
    return {p=p,part=hit.Instance,top=top,inward=-hit.Normal}
end
local function startPull(s,root)
    local h=s.hang
    if not h then return end
    local goal=Vector3.new(root.Position.X,h.top+3.2,root.Position.Z)+h.inward*3.68
    local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={s.character}
    for _,part in workspace:GetPartBoundsInBox(CFrame.new(goal),Vector3.new(2.8,6,2.8),params) do
        if part.CanCollide then return end
    end
    s.pull={from=root.Position,to=goal,start=os.clock()};s.hang=nil
end
local function launch(s,root,hum,x,z)
    local velocity=Jump.release(s.charge,os.clock(),ground(s.character,root)~=nil,x,z)
    s.charge=nil; hum.WalkSpeed=Traverse.walkSpeed(s.running,s.charge~=nil)
    if not velocity then return end
    local bonus=s.running and 1+Traverse.RunJumpBonus or 1
    s.flight=Vector3.new(velocity.x*bonus,0,velocity.z*bonus)
    s.flightAt=os.clock()
    root:SetNetworkOwner(nil)
    hum:ChangeState(Enum.HumanoidStateType.Freefall)
    root.AssemblyLinearVelocity=Vector3.new(s.flight.X,velocity.y,s.flight.Z)
end
remote.OnServerEvent:Connect(function(player,action,payload)
    local s=sessions[player]
    if not s or not Ingress.allow(s,os.clock()) then return end
    if action=="sync" then notify(player,s); return end
    if type(payload)~="table" or payload.epoch~=s.fall.epoch or s.busy or s.locked then return end
    if action=="move" then
        local x,z=payload.x,payload.z
        if Jump.finite(x) and Jump.finite(z) and x*x+z*z&lt;=1.21 then
            s.wish=Vector3.new(x,0,z)
            if s.wish.Magnitude&gt;1 then s.wish=s.wish.Unit end
        end
        return
    end
    local now=os.clock()
    if action~="release" and now-(s.lastAction or 0)&lt;0.06 then return end
    s.lastAction=now
    local root=rootOf(s.character)
    local hum=s.character and s.character:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health&lt;=0 then return end
    if action=="grab" then
        if s.hang or s.climb or s.pull then detach(s,root)
        elseif not ground(s.character,root) and (s.stamina or 100)&gt;0 then
            local d=(s.wish or Vector3.zero).Magnitude&gt;0.01 and (s.wish or Vector3.zero) or root.CFrame.LookVector
            local wall=surface(s,root,d)
            if wall and wall.p.kind=="Wall" and wall.top-(root.Position.Y-3)&gt;8.8 then
                s.climb=wall;s.flight=nil;s.charge=nil;root.Anchored=true;s.character:SetAttribute("InfinityHanging",true)
            end
        end
    elseif action=="run" then
        s.running=payload.enabled==true;hum.WalkSpeed=Traverse.walkSpeed(s.running,s.charge~=nil)
    elseif action=="start" then
        if s.hang then startPull(s,root);notify(player,s);return end
        if s.climb or s.pull then return end
        local x,z=Jump.direction(payload.x,payload.z)
        if not s.charge and not s.flight and x and ground(s.character,root) then
            s.charge=now;s.direction={x,z};hum.WalkSpeed=Traverse.walkSpeed(s.running,true)
        end
    elseif action=="release" then
        if not s.charge then return end
        launch(s,root,hum,payload.x,payload.z)
    elseif action=="dismiss" then Fall.clear(s.fall)
    elseif action=="restart" then
        Fall.clear(s.fall);detach(s,root);s.charge=nil;s.flight=nil;hum.WalkSpeed=Traverse.walkSpeed(s.running,s.charge~=nil)
        place(s.character,{courseVersion=Course.version,platformId="Start"});s.fall.safeRegion=1;s.fall.safeY=0
    elseif action=="use" and Fall.valid(s.fall,payload.token,payload.epoch) and s.loaded then
        local character=s.character
        local target={courseVersion=Course.version,platformId=s.fall.offer.platformId}
        local operation=Http:GenerateGUID(false)
        s.busy=true;s.locked=true;freeze(character,true)
        local record,err=ledger:reserve(player.UserId,operation,target)
        if record then
            s.record=record
            Fall.clear(s.fall)
            if s.character==character then
                record,err,s.handoff=Delivery.run(ledger,player.UserId,record,character,function() return s.character end,freeze,place)
                if record then s.record=record end
            else record=nil;err="Delivery retained for current character" end
        end
        s.busy=false
        if record and s.character==character then s.locked=false;s.error=nil
        elseif s.character==character then
            s.error=err
            -- A rejected reservation must also check for a competing pending delivery before unlocking.
        end
        s.charge=nil;s.flight=nil
    elseif action=="purchase" and not STUDIO and s.loaded and PRODUCT_ID&gt;0 and productPrice then
        Marketplace:PromptProductPurchase(player,PRODUCT_ID)
    end
    notify(player,s)
end)
Marketplace.ProcessReceipt=function(receipt)
    local granted=Receipt.process(receipt,PRODUCT_ID,function(id)
        local p=Players:GetPlayerByUserId(id)
        return p~=nil and sessions[p]~=nil and sessions[p].loaded
    end,ledger)
    if granted then
        local p=Players:GetPlayerByUserId(receipt.PlayerId)
        local s=p and sessions[p]
        if s then
            -- Refresh via atomic read; never replace newer grants with a stale save.
            local record,err=ledger:load(p.UserId)
            if record then s.record=record else s.error=err end
            notify(p,s)
        end
    end
    return granted and Enum.ProductPurchaseDecision.PurchaseGranted or Enum.ProductPurchaseDecision.NotProcessedYet
end
local function addPlayer(player)
    -- A new owner and independent epoch/sequence state on EVERY join, including a return
    -- to this still-running server after a different server claimed the saved run.
    local s={fall=Fall.new(),locked=true,loaded=false,best=0,
        progress=Progress.new(updateProgress,Course.seed,Http:GenerateGUID(false))}
    sessions[player]=s
    local function spawn(character)
        local root=character:WaitForChild("HumanoidRootPart")
        local hum=character:WaitForChild("Humanoid")
        s.character=character;s.charge=nil;s.flight=nil;s.hang=nil;s.climb=nil;s.pull=nil;s.stamina=100;s.running=false;s.locked=true
        Fall.character(s.fall,s.died==true);s.died=false
        hum.UseJumpPower=true;hum.JumpPower=0;hum.WalkSpeed=Traverse.walkSpeed(s.running,s.charge~=nil)
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,false)
        freeze(character,true)
        hum.Died:Connect(function()
            if s.character~=character then return end
            Fall.death(s.fall);s.died=true;s.charge=nil;s.flight=nil;s.falls=(s.falls or 0)+1
        end)
        recover(player,s,character)
    end
    player.CharacterAdded:Connect(spawn)
    if player.Character then task.spawn(spawn,player.Character) end
end
Players.PlayerAdded:Connect(addPlayer)
for _,player in Players:GetPlayers() do addPlayer(player) end
local function saveProgress(player,s)
    if not s.progressLoaded then return end
    local root=rootOf(s.character)
    local alt=root and math.max(0,root.Position.Y-3) or s.height or 0
    s.progressPending={alt=alt,best=math.max(s.best or 0,alt),falls=s.falls or 0,elapsed=s.elapsed or 0,summitSec=s.summitSec or 0}
    if s.progressSaving then return end
    s.progressSaving=true
    repeat
        local sample=s.progressPending;s.progressPending=nil
        local result,err=s.progress:save(player.UserId,sample)
        if not result then s.error=err end
    until not s.progressPending
    s.progressSaving=false
    if s.leaving then s.progress:close() end
end
Players.PlayerRemoving:Connect(function(player)
    local s=sessions[player]
    if not s then return end
    s.leaving=true
    local root=rootOf(s.character)
    s.height=root and math.max(0,root.Position.Y-3) or s.height
    s.character=nil
    sessions[player]=nil
    -- Drain an already-yielding final sample using this join's handle. New joins get
    -- a different owner; their atomic claim fences this old work even before close.
    saveProgress(player,s)
    if not s.progressSaving then s.progress:close() end
end)
local tickAccum=0
Run.Heartbeat:Connect(function(dt)
    tickAccum+=dt
    local send=tickAccum&gt;=0.15
    if send then tickAccum=0 end
    local deltas=world:tick(dt)
    for player,s in sessions do
        local root=rootOf(s.character)
        local hum=s.character and s.character:FindFirstChildOfClass("Humanoid")
        if not root or not hum then continue end
        if s.locked then
            if not s.busy and os.clock()-(s.retryAt or 0)&gt;2 then
                s.retryAt=os.clock();task.spawn(recover,player,s,s.character)
            end
            continue
        end
        if hum.Health&lt;=0 then continue end
        s.elapsed=(s.elapsed or 0)+dt
        if os.clock()-(s.progressSaveAt or 0)&gt;5 then
            s.progressSaveAt=os.clock();task.spawn(saveProgress,player,s)
        end
        if s.pull then
            local p=s.pull;local t=math.clamp((os.clock()-p.start)/Traverse.PullTime,0,1)
            local up=math.min(1,t*1.4);up=up*up*(3-2*up)
            root.CFrame=CFrame.new(p.from.X+(p.to.X-p.from.X)*t*t,p.from.Y+(p.to.Y-p.from.Y)*up,p.from.Z+(p.to.Z-p.from.Z)*t*t)
            if t&gt;=1 then detach(s,root) end
        elseif s.hang or s.climb then
            local h=s.hang or s.climb
            s.stamina=Traverse.drain(s.stamina,dt);s.regainAt=os.clock()+Traverse.RegainDelay
            if s.stamina&lt;=0 or not h.part.CanCollide then detach(s,root)
            elseif s.hang then
                local want=h.top-Traverse.LedgeMaxRise+3
                root.CFrame=root.CFrame+Vector3.new(0,(want-root.Position.Y)*(1-math.exp(-14*dt)),0)
            else
                local direction=(s.wish or Vector3.zero)
                local up=direction:Dot(h.inward)
                local side=Vector3.new(h.inward.Z,0,-h.inward.X)
                local lateral=direction:Dot(side)
                local step=(Vector3.new(0,up,0)+side*lateral)
                if step.Magnitude&gt;1 then step=step.Unit end
                local wall=surface(s,root,h.inward)
                if not wall or wall.p.kind~="Wall" then detach(s,root)
                else root.CFrame=root.CFrame+step*Traverse.ClimbSpeed*dt end
                if s.climb and h.top-(root.Position.Y-3)&lt;=Traverse.LedgeMaxRise then s.hang=h;s.climb=nil;startPull(s,root) end
            end
            root.AssemblyLinearVelocity=Vector3.zero
        end
        if s.hang or s.climb or s.pull then
            s.height=math.max(0,root.Position.Y-3);s.best=math.max(s.best,s.height)
            if send then notify(player,s) end
            continue
        end
        if s.charge and os.clock()-s.charge&gt;=Jump.MaxHold then launch(s,root,hum,s.direction[1],s.direction[2]) end
        local floor=ground(s.character,root)
        local velocity=root.AssemblyLinearVelocity
        local look=Course.look(root.Position.Y)
        if not floor then
            velocity+=Vector3.new(look.wind[1],0,look.wind[3])*dt
            -- Workspace gravity is global; compensate per avatar for the original altitude scale.
            velocity+=Vector3.new(0,Jump.Gravity*(1-look.gravity)*dt,0)
            root.AssemblyLinearVelocity=velocity
            if os.clock()&gt;(s.cool or 0) then
                local d=s.flight and s.flight.Magnitude&gt;0.01 and s.flight or (s.wish or Vector3.zero).Magnitude&gt;0.01 and (s.wish or Vector3.zero) or root.CFrame.LookVector
                local ledge=surface(s,root,d)
                local rise=ledge and ledge.top-(root.Position.Y-3) or 0
                local stamina=Traverse.grab(s.stamina or 100,rise)
                if ledge and stamina and not (velocity.Y&gt;0 and root.Position.Y-3+velocity.Y^2/(2*Jump.Gravity*look.gravity)&gt;=ledge.top) then
                    s.stamina=stamina;s.hang=ledge;s.flight=nil;s.charge=nil;root.Anchored=true
                    s.character:SetAttribute("InfinityHanging",true)
                end
            end
        end
        if floor then
            if os.clock()&gt;=(s.regainAt or 0) then s.stamina=math.min(100,(s.stamina or 100)+Traverse.Regain*dt) end
            world:stand(floor.Name,dt)
            if deltas[floor.Name] then root.CFrame+=deltas[floor.Name] end
            local platform=Course.platform(floor.Name)
            if platform and platform.grade&gt;0 and (platform.kind=="Ice" or platform.grade&gt;=0.45) then
                root.AssemblyLinearVelocity+=Vector3.new(-platform.slopeX,0,-platform.slopeZ)*(platform.grade*36*dt)
            end
        end
        if s.flight then
            hum:Move(Vector3.zero,false)
            if floor and os.clock()-s.flightAt&gt;0.15 and velocity.Y&lt;2 then
                s.flight=nil;root:SetNetworkOwnershipAuto()
            else
                -- Sweep forward to stop against walls; never CFrame through collision solids.
                local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={s.character}
                local hit=workspace:Raycast(root.Position,s.flight*math.max(dt,0.03)+(s.flight.Magnitude&gt;0.01 and s.flight.Unit*1.2 or Vector3.zero),params)
                if hit and math.abs(hit.Normal.Y)&lt;0.7 then s.flight=Vector3.zero end
                root.AssemblyLinearVelocity=Vector3.new(s.flight.X,math.max(-Traverse.TerminalFall,velocity.Y),s.flight.Z)
            end
        elseif not floor then
            -- KgdTraverse.Air: walking off remains steerable at 3/s toward run speed.
            local wish=(s.wish or Vector3.zero)
            local x,y,z=Traverse.air(velocity.X,velocity.Y,velocity.Z,wish.X,wish.Z,dt,false)
            root.AssemblyLinearVelocity=Vector3.new(x,y,z)
        end
        if floor and math.abs(velocity.Y)&lt;2 then
            if s.floor==floor then s.stable=(s.stable or 0)+dt else s.floor=floor;s.stable=0 end
            if s.stable&gt;=0.12 then
                Fall.land(s.fall,Course.platform(floor.Name))
                if s.airPeak and s.airPeak-(root.Position.Y-3)&gt;40 then s.falls=(s.falls or 0)+1 end
                s.airPeak=nil
                if floor.Name==Course.path[#Course.path] then
                    s.finished=true
                    if (s.summitSec or 0)==0 then s.summitSec=s.elapsed end
                end
            end
        else s.floor=nil;s.stable=0;s.airPeak=math.max(s.airPeak or 0,root.Position.Y-3) end
        s.height=math.max(0,root.Position.Y-3)
        s.best=math.max(s.best,s.height)
        Fall.sample(s.fall,s.height,velocity.Y &lt; -2)
        if root.Position.Y &lt; -35 then hum.Health=0 end
        if send then notify(player,s) end
    end
end)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0467">
        <Properties>
          <string name="Name">Progress</string>
          <ProtectedString name="Source">-- Current descent altitude, separate from ticket inventory. Atomic owner/epoch/sample fences
-- reject old-server exit saves and out-of-order UpdateAsync retries after a newer lower save.
local Progress={}
local function finite(v) return type(v)=="number" and v==v and math.abs(v)&lt;math.huge end
local function valid(v,seed)
    return type(v)=="table" and v.version==1 and v.seed==seed and finite(v.alt) and v.alt&gt;=0 and
        finite(v.best) and v.best&gt;=v.alt and finite(v.falls) and v.falls&gt;=0 and
        finite(v.elapsed or 0) and finite(v.summitSec or 0)
end
function Progress.new(update,seed,owner)
    assert(type(owner)=="string" and #owner&gt;0,"Each player join requires a distinct progress owner")
    return setmetatable({update=update,seed=seed,owner=owner,claims={},sequences={},closed=false},{__index=Progress})
end
function Progress:close()
    self.closed=true;self.claims={};self.sequences={}
end
function Progress:load(userId)
    if self.closed then return nil,"종료된 진행 세션" end
    local key=tostring(userId)
    local claim=self.claims[key]
    local ok,result=pcall(self.update,key,function(old)
        if self.closed then return nil end
        if old==nil then old={version=1,seed=self.seed,alt=0,best=0,falls=0,elapsed=0,summitSec=0} end
        if not valid(old,self.seed) then return old end
        if claim then return old end
        local nextRecord=table.clone(old)
        nextRecord.owner=self.owner;nextRecord.sessionEpoch=(old.sessionEpoch or 0)+1;nextRecord.sampleSequence=0
        return nextRecord
    end)
    if self.closed then return nil,"종료된 진행 세션" end
    if not ok then return nil,"진행 저장소 연결 실패" end
    if not valid(result,self.seed) then return nil,"진행 저장 형식 또는 맵 시드 불일치" end
    if result.owner~=self.owner or claim and result.sessionEpoch~=claim then return nil,"다른 세션에서 이어하는 중입니다" end
    self.claims[key]=result.sessionEpoch;self.sequences[key]=math.max(self.sequences[key] or 0,result.sampleSequence or 0)
    return result
end
function Progress:save(userId,sample)
    if self.closed then return nil,"종료된 진행 세션" end
    if not finite(sample.alt) or not finite(sample.best) or not finite(sample.falls) or sample.alt&lt;0 or sample.best&lt;sample.alt then return nil,"잘못된 진행 값" end
    local key=tostring(userId);local epoch=self.claims[key]
    if not epoch then return nil,"진행 세션을 먼저 불러와야 합니다" end
    local sequence=(self.sequences[key] or 0)+1;self.sequences[key]=sequence
    local ok,result=pcall(self.update,key,function(old)
        if self.closed or not valid(old,self.seed) or old.owner~=self.owner or old.sessionEpoch~=epoch then return nil end
        if (old.sampleSequence or 0)&gt;sequence then return nil end
        if old.sampleSequence==sequence then return old end
        return {version=1,seed=self.seed,owner=self.owner,sessionEpoch=epoch,sampleSequence=sequence,
            alt=sample.alt,best=math.max(old.best,sample.best),falls=math.max(old.falls,sample.falls),
            elapsed=sample.elapsed or old.elapsed or 0,summitSec=(old.summitSec or 0)&gt;0 and old.summitSec or sample.summitSec or 0}
    end)
    if not ok or not result then return nil,"진행 저장 실패 또는 오래된 세션 · 기존 기록 유지" end
    return result
end
return Progress
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0468">
        <Properties>
          <string name="Name">Receipt</string>
          <ProtectedString name="Source">local Receipt = {}
-- Acknowledgement decisions are plain booleans; Roblox enum conversion is at the edge.
function Receipt.process(receipt, productId, online, ledger)
    if productId==0 or receipt.ProductId~=productId or not online(receipt.PlayerId) then return false end
    local record=ledger:grant(receipt.PlayerId,receipt.PurchaseId)
    return record~=nil
end
return Receipt
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0469">
        <Properties>
          <string name="Name">Recovery</string>
          <ProtectedString name="Source">-- Shared by the actual Roblox recovery adapter and executable failure-boundary tests.
local Recovery={}
function Recovery.finish(session,character,record,err)
    if record and session.character==character then
        session.locked=false;session.error=nil
    else
        session.locked=true;session.error=err or "안전 전달을 재시도합니다"
    end
    session.busy=false
end
return Recovery
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0470">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">-- Original Tower.Tick/KgdMover/Climber.WorldStep; rendering uses the same collision parts.
local Terrain=require(game:GetService("ReplicatedStorage"):WaitForChild("InfinityStep").Terrain)
local World={}
function World.new(course,folder)
    local self={time=0,parts={},crumble={},course=course,movers={}}
    for _,part in folder:GetChildren() do
        if part:IsA("BasePart") then
            self.parts[part.Name]=self.parts[part.Name] or {}
            table.insert(self.parts[part.Name],part)
            local p=course.platform(part.Name)
            if p and p.kind=="Ice" then part.CustomPhysicalProperties=PhysicalProperties.new(1,0.02,0,100,100) end
        end
    end
    for _,p in course.platforms do if p.mover&gt;0 then table.insert(self.movers,p) end end
    return setmetatable(self,{__index=World})
end
function World:stand(id,dt)
    local p=self.course.platform(id)
    if not p or p.kind~="Crumble" then return end
    self.crumble[id]=Terrain.stand(self.crumble[id],dt)
end
function World:tick(dt)
    self.time+=dt
    local deltas={}
    for _,p in self.movers do
        if p.mover&gt;0 then
            local m=self.course.movers[p.mover]
            local x,y,z=Terrain.mover(m,self.time)
            local at=Vector3.new(x,y,z)
            local parts=self.parts[p.id]
            if parts then
                local part=parts[1];local nextPosition=at-Vector3.new(0,p.depth/2,0)
                deltas[p.id]=nextPosition-part.Position;part.Position=nextPosition
            end
        end
    end
    for id,c in self.crumble do
        self.crumble[id]=Terrain.tick(c,dt)
        local gone=c.stage==2 and self.crumble[id]~=nil
        for _,part in self.parts[id] or {} do
            part.CanCollide=not gone;part.Transparency=gone and 1 or 0
        end
    end
    return deltas
end
return World
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX0451">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX0452">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX0471">
        <Properties>
          <string name="Name">Hud</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local Input=game:GetService("UserInputService")
local Action=game:GetService("ContextActionService")
local Run=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("InfinityStep")
local Jump=require(Shared.Jump)
local ChargeInput=require(Shared.ChargeInput)
local HudLayout=require(Shared.HudLayout)
local Course=require(Shared.Course)
local Theme=require(Shared.Theme)
local remote=Shared:WaitForChild("Action")
local state=Shared:WaitForChild("State")
local player=Players.LocalPlayer
local function color(name) return Color3.fromRGB(table.unpack(Theme[name])) end
local gui=Instance.new("ScreenGui")
gui.Name="InfinityStepHUD";gui.ResetOnSpawn=false;gui.IgnoreGuiInset=false
gui.ScreenInsets=Enum.ScreenInsets.DeviceSafeInsets
gui.Parent=player:WaitForChild("PlayerGui")
local canvas=Instance.new("Frame")
canvas.Size=UDim2.fromScale(1,1);canvas.BackgroundTransparency=1;canvas.Parent=gui
local function text(parent,kind,label,size,pos)
    local item=Instance.new(kind)
    item.Text=label;item.Size=size;item.Position=pos
    item.Font=Enum.Font.GothamMedium;item.TextSize=Theme.textSize
    item.TextColor3=color("hanji");item.BackgroundColor3=color("giwa")
    item.BorderSizePixel=0;item.TextWrapped=true;item.Parent=parent
    return item
end
local status=text(canvas,"TextLabel","인피니티 스탭 / 연결 중",UDim2.new(1,-32,0,72),UDim2.fromOffset(16,12))
local meter=text(canvas,"TextLabel","[ ] [ ] [ ] [ ] [ ]",UDim2.fromOffset(240,40),UDim2.new(0.5,-120,0,88))
local help=text(canvas,"TextLabel","WASD 이동 · C/Space 점프 · X 잡기/놓기 · Z 달리기 · 우클릭 시점",UDim2.new(1,-32,0,36),UDim2.fromOffset(16,132))
help.TextSize=14
local jump=text(canvas,"TextButton","누르고\n점프",UDim2.fromOffset(96,72),UDim2.new(1,-116,1,-240))
jump.BackgroundColor3=color("yeonji")
local grab=text(canvas,"TextButton","잡기/놓기",UDim2.fromOffset(64,56),UDim2.fromOffset(0,0))
local runButton=text(canvas,"TextButton","달리기",UDim2.fromOffset(64,44),UDim2.fromOffset(0,0))
local runOwner={}
local panel=Instance.new("Frame")
panel.Size=UDim2.new(1,-32,0,180);panel.Position=UDim2.fromOffset(16,176)
panel.BackgroundColor3=color("giwa");panel.Visible=false;panel.Parent=canvas
local destination=text(panel,"TextLabel","",UDim2.new(1,-16,0,64),UDim2.fromOffset(8,0))
local use=text(panel,"TextButton","부활권 1장 사용",UDim2.new(0.5,-12,0,48),UDim2.fromOffset(8,72))
use.BackgroundColor3=color("celadon")
local dismiss=text(panel,"TextButton","무료로 계속",UDim2.new(0.5,-12,0,48),UDim2.new(0.5,4,0,72))
local buy=text(panel,"TextButton","구매 비활성",UDim2.new(1,-16,0,48),UDim2.fromOffset(8,128))
local restart=text(canvas,"TextButton","처음부터 (무료)",UDim2.fromOffset(128,48),UDim2.new(1,-144,1,-304))
local data={epoch=0,locked=true,balance=0}
local held=nil
local moveSentAt=0
local inputOwner={}
local function reflow()
    local size=canvas.AbsoluteSize
    if size.X&lt;=0 or size.Y&lt;=0 then return end
    local layout=HudLayout.compute(size.X,size.Y,data.offer~=nil)
    for name,item in {status=status,meter=meter,help=help,jump=jump,grab=grab,run=runButton,restart=restart,panel=panel} do
        local r=layout[name]
        item.Position=UDim2.fromOffset(r.x,r.y);item.Size=UDim2.fromOffset(r.w,r.h)
    end
    status.TextSize=layout.compact and 14 or Theme.textSize
    if data.region then status.Text=HudLayout.status(data,layout.compact) end
    help.Visible=not layout.compact and not layout.modal
    meter.Visible=not layout.modal
    jump.Visible=not layout.modal;grab.Visible=not layout.modal;runButton.Visible=not layout.modal;restart.Visible=not layout.modal
end
canvas:GetPropertyChangedSignal("AbsoluteSize"):Connect(reflow)
reflow()
local function send(action,extra)
    local payload=extra or {};payload.epoch=data.epoch
    remote:FireServer(action,payload)
end
local function direction()
    local character=player.Character
    local hum=character and character:FindFirstChildOfClass("Humanoid")
    local dir=hum and hum.MoveDirection or Vector3.zero
    if dir.Magnitude&lt;0.01 then
        local camera=workspace.CurrentCamera
        dir=camera and camera.CFrame.LookVector or Vector3.new(1,0,0)
    end
    dir=Vector3.new(dir.X,0,dir.Z)
    if dir.Magnitude&lt;0.01 then dir=Vector3.new(1,0,0) end
    return dir.Unit
end
local function begin(input)
    if held or data.locked or not ChargeInput.begin(inputOwner,input) then return end
    held=os.clock()
    local dir=direction();send("start",{x=dir.X,z=dir.Z})
end
local function finish(input,forced)
    local accepted=forced and ChargeInput.cancel(inputOwner) or ChargeInput.finish(inputOwner,input)
    if not held or not accepted then return end
    held=nil
    local dir=direction();send("release",{x=dir.X,z=dir.Z})
end
Action:BindActionAtPriority("InfinityCharge",function(_,inputState)
    if inputState==Enum.UserInputState.Begin then begin("bound")
    elseif inputState==Enum.UserInputState.End or inputState==Enum.UserInputState.Cancel then finish("bound") end
    return Enum.ContextActionResult.Sink
end,false,3000,Enum.KeyCode.C,Enum.KeyCode.Space,Enum.KeyCode.ButtonA)
Action:BindAction("InfinityGrab",function(_,inputState)
    if inputState==Enum.UserInputState.Begin then send("grab") end
    return Enum.ContextActionResult.Sink
end,false,Enum.KeyCode.X)
Action:BindAction("InfinityRun",function(_,inputState)
    send("run",{enabled=inputState==Enum.UserInputState.Begin})
    return Enum.ContextActionResult.Sink
end,false,Enum.KeyCode.Z,Enum.KeyCode.LeftShift)
grab.Activated:Connect(function() if not data.locked then send("grab") end end)
runButton.InputBegan:Connect(function(input)
    if data.locked then return end
    if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
        if ChargeInput.begin(runOwner,input) then send("run",{enabled=true}) end
    end
end)
jump.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then begin(input) end
end)
Input.InputEnded:Connect(function(input)
    if ChargeInput.finish(runOwner,input) then send("run",{enabled=false}) end
    if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then finish(input) end
end)
Input.WindowFocusReleased:Connect(function() finish(nil,true);if ChargeInput.cancel(runOwner) then send("run",{enabled=false}) end end)
use.Activated:Connect(function() if data.offer and data.balance&gt;0 then send("use",{token=data.offer.token}) end end)
dismiss.Activated:Connect(function() send("dismiss") end)
restart.Activated:Connect(function() send("restart") end)
buy.Activated:Connect(function() if data.purchase and not data.locked then send("purchase") end end)
state.OnClientEvent:Connect(function(nextData)
    if data.epoch~=nextData.epoch or nextData.locked then held=nil;ChargeInput.cancel(inputOwner) end
    data=nextData
    help.Text=data.error and ("저장: "..data.error) or data.hanging and "매달림: C/Space로 올라서기 · X로 놓기" or "WASD 이동 · C/Space 점프 · X 잡기/놓기 · Z 달리기 · 우클릭 시점"
    panel.Visible=data.offer~=nil
    if data.offer then destination.Text="복귀: "..data.offer.platformId.." / "..Course.regions[data.offer.region].name.."?\n선택 사항 · 무료로 계속할 수 있습니다" end
    use.Text=data.balance&gt;0 and "부활권 1장 사용" or "부활권 없음"
    use.Active=data.balance&gt;0 and not data.locked
    buy.Text=data.purchase and ("부활권 1장 · "..tostring(data.price).." Robux") or (data.test and "스튜디오 · 테스트 3장 · 구매 비활성" or "구매 비활성")
    buy.Active=data.purchase==true and not data.locked
    reflow()
end)
Run.RenderStepped:Connect(function()
    if not data.locked and os.clock()-moveSentAt&gt;=0.1 then
        moveSentAt=os.clock()
        local character=player.Character
        local hum=character and character:FindFirstChildOfClass("Humanoid")
        local wish=hum and hum.MoveDirection or Vector3.zero
        send("move",{x=wish.X,z=wish.Z})
    end
    local level=held and Jump.level(os.clock()-held) or 0
    local segments={}
    for i=1,5 do segments[i]=i&lt;=level and "[■]" or "[ ]" end
    meter.Text=table.concat(segments," ")..((data.hanging or data.climbing or (data.stamina or 100)&lt;99) and string.format("  체력 %.0f",data.stamina or 100) or "")
    if held and os.clock()-held&gt;=Jump.MaxHold then finish(nil,true) end
end)
player.CharacterAdded:Connect(function() held=nil;ChargeInput.cancel(inputOwner);send("sync") end)
send("sync")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX0472">
        <Properties>
          <string name="Name">Orbit</string>
          <ProtectedString name="Source">-- KgdOrbitCam: FOV58, pitch -32..62, distance7..15 source units, lookahead2.6.
local Players=game:GetService("Players")
local Input=game:GetService("UserInputService")
local Run=game:GetService("RunService")
local Course=require(game:GetService("ReplicatedStorage"):WaitForChild("InfinityStep").Course)
local Lighting=game:GetService("Lighting")
local player=Players.LocalPlayer
local yaw,pitch=0,math.rad(16)
local distance=60
local focus,previous,ahead=nil,nil,Vector3.zero
local dragging=false
local touch=nil
local function reset()
    focus=nil;previous=nil;ahead=Vector3.zero
    local first=Course.platforms[2] or Course.platforms[1]
    local start=Course.platform("Start") or {x=0,z=-8}
    yaw=math.atan2(first.x-start.x,first.z-start.z)
end
reset()
Input.InputBegan:Connect(function(input,processed)
    if processed then return end
    if input.UserInputType==Enum.UserInputType.MouseButton2 then dragging=true end
    if input.UserInputType==Enum.UserInputType.Touch then
        local camera=workspace.CurrentCamera
        if camera and input.Position.X&gt;camera.ViewportSize.X*0.45 then touch=input end
    end
end)
Input.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton2 then dragging=false end
    if input==touch then touch=nil end
end)
Input.InputChanged:Connect(function(input)
    if dragging and input.UserInputType==Enum.UserInputType.MouseMovement or input==touch then
        yaw-=math.rad(input.Delta.X*0.16)
        pitch=math.clamp(pitch+math.rad(input.Delta.Y*0.12),math.rad(-32),math.rad(62))
    end
end)
Input.WindowFocusReleased:Connect(function() dragging=false;touch=nil end)
player.CharacterAdded:Connect(reset)
Run:BindToRenderStep("InfinityOrbit",Enum.RenderPriority.Camera.Value+1,function(dt)
    local character=player.Character
    local root=character and character:FindFirstChild("HumanoidRootPart")
    local camera=workspace.CurrentCamera
    if not root or not camera then return end
    camera.CameraType=Enum.CameraType.Scriptable;camera.FieldOfView=58
    local target=root.Position-Vector3.new(0,3,0)
    local vel=previous and (target-previous)/math.max(dt,0.0001) or Vector3.zero
    previous=target
    local flat=Vector3.new(vel.X,0,vel.Z)
    local want=flat.Magnitude&gt;8 and flat.Unit*10.4 or Vector3.zero
    ahead=ahead:Lerp(want,1-math.exp(-2.5*dt))
    local desired=target+Vector3.new(0,5.4,0)+ahead
    focus=focus and focus:Lerp(desired,1-math.exp(-9*dt)) or desired
    local close=character:GetAttribute("InfinityHanging")==true
    distance+=( (close and 28 or 60)-distance)*(1-math.exp(-4*dt))
    local forward=Vector3.new(math.sin(yaw)*math.cos(pitch),-math.sin(pitch),math.cos(yaw)*math.cos(pitch))
    local delta=-forward*distance
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={character}
    local hit=workspace:Raycast(focus,delta,params)
    local at=hit and hit.Position+hit.Normal*2 or focus+delta
    local floor=workspace:Raycast(at+Vector3.new(0,4.4,0),Vector3.new(0,-8.8,0),params)
    if floor and at.Y&lt;floor.Position.Y+4.4 then at=Vector3.new(at.X,floor.Position.Y+4.4,at.Z) end
    camera.CFrame=CFrame.lookAt(at,focus);camera.Focus=CFrame.new(focus)
    local look=Course.look(target.Y)
    local sky=Color3.new(look.sky[1],look.sky[2],look.sky[3])
    Lighting.FogColor=sky;Lighting.FogStart=look.fogStart;Lighting.FogEnd=look.fogEnd
    Lighting.Ambient=sky*2.1+Color3.new(0.05,0.045,0.04);Lighting.Brightness=look.sunPower
end)
</ProtectedString>
        </Properties>
      </Item>
