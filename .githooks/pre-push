#!/bin/bash
# Pre-push hook (tracked: .githooks/) — 활성화: scripts/install-hooks.sh
#
# 책임:
#   1. GitHub auth account = 1989v
#   2. push 되는 커밋의 author = kgd <1989v@naver.com>
#   3. 서브모듈 포인터가 원격에 실제로 존재
#   4. Kotlin 소스나 서브모듈 포인터가 바뀌면 구조 게이트 verifyArchitecture (ADR-0083) — **푸시하는 커밋 그대로** 검사
#
# main 이 곧 배포 브랜치라 CI 는 "밀고 난 뒤" 다. 여기가 위반을 막을 수 있는 마지막 지점이다.

REQUIRED_GH_ACCOUNT="1989v"
REQUIRED_NAME="kgd"
REQUIRED_EMAIL="1989v@naver.com"

# --- Check 1: GitHub auth account ---
ACTIVE_ACCOUNT=$(gh auth status 2>&1 | grep "Active account: true" -B3 | grep "account" | head -1 | sed 's/.*account \([^ ]*\).*/\1/')

if [ "$ACTIVE_ACCOUNT" != "$REQUIRED_GH_ACCOUNT" ]; then
    echo ""
    echo "❌ PUSH BLOCKED: active GitHub account is '$ACTIVE_ACCOUNT', not '$REQUIRED_GH_ACCOUNT'"
    echo ""
    echo "   Fix: gh auth switch --user $REQUIRED_GH_ACCOUNT"
    echo ""
    exit 1
fi

# --- Check 2: Commit author on commits being pushed ---
remote="$1"
url="$2"
KT_TOUCHED=""
PUSH_OID=""
SUB_PATHS=$(git config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null | awk '{print $2}')

while read local_ref local_oid remote_ref remote_oid; do
    if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
        continue  # branch delete
    fi

    if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
        range="$local_oid"
    else
        range="$remote_oid..$local_oid"
    fi

    # 게이트를 돌릴지 판단 (Check 4). 루프 밖에서 쓰므로 여기서 모아 둔다.
    # 서브모듈 포인터가 바뀐 것도 코드가 바뀐 것이다 — 포인터만 올린 커밋이 게이트를 건너뛰면 안 된다
    CHANGED=$(git diff --name-only "$range" 2>/dev/null)
    if printf '%s\n' "$CHANGED" | grep -q '\.kt$' || printf '%s\n' "$CHANGED" | grep -qxF -f <(printf '%s\n' $SUB_PATHS); then
        KT_TOUCHED=1
    fi
    PUSH_OID="$local_oid"

    BAD_COMMITS=$(git log "$range" --format='%H %an <%ae>' 2>/dev/null | grep -v "$REQUIRED_NAME <$REQUIRED_EMAIL>" | grep -v "Co-Authored-By")

    if [ -n "$BAD_COMMITS" ]; then
        echo ""
        echo "❌ PUSH BLOCKED: commits with wrong author detected"
        echo ""
        echo "$BAD_COMMITS" | while read line; do
            echo "   $line"
        done
        echo ""
        echo "   Expected: $REQUIRED_NAME <$REQUIRED_EMAIL>"
        echo "   Fix: git rebase -i <base> --exec 'git commit --amend --author=\"$REQUIRED_NAME <$REQUIRED_EMAIL>\" --no-edit'"
        echo ""
        exit 1
    fi

    # --- Check 3: 서브모듈 포인터가 원격에 실제로 존재하는가 ---
    # 서브모듈 커밋을 먼저 push 하지 않고 본체 포인터만 올리면, CI 는 그 커밋을
    # 받을 수 없어 죽는다 ("upload-pack: not our ref"). 이미지가 아예 안 만들어지므로
    # 그 커밋의 변경분은 운영에 영원히 반영되지 않는다 (2026-08-22·23 images 3회).
    # `git push` 는 훅에 GIT_DIR 을 **상위 레포로 설정해** 넘긴다. 그대로 두면 `git -C <서브모듈>` 이
    # 서브모듈이 아니라 상위 레포를 보고, 거기엔 그 커밋이 없으니 **언제나 "원격에 없다"** 가 된다
    # (서브모듈이 체크아웃된 모든 푸시가 막혔다 — 2026-09-07). 환경변수를 걷어내고 부른다.
    sub_git() { env -u GIT_DIR -u GIT_WORK_TREE git -C "$@"; }
    sub_contains() { sub_git "$1" branch -r --contains "$2" 2>/dev/null | grep -q .; }

    SUB_BAD=""
    for sub_path in $(git config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null | awk '{print $2}'); do
        sub_sha=$(git rev-parse "$local_oid:$sub_path" 2>/dev/null) || continue
        # 로컬에 체크아웃되지 않은 서브모듈은 판정 불가 → 건너뛴다
        [ -e "$sub_path/.git" ] || continue
        if ! sub_contains "$sub_path" "$sub_sha"; then
            sub_git "$sub_path" fetch -q origin 2>/dev/null || true
            sub_contains "$sub_path" "$sub_sha" || SUB_BAD="${SUB_BAD}${sub_path} ${sub_sha}"$'\n'
        fi
    done

    if [ -n "$SUB_BAD" ]; then
        echo ""
        echo "❌ PUSH BLOCKED: 원격에 없는 서브모듈 커밋을 가리키고 있다"
        echo ""
        printf '%s' "$SUB_BAD" | while read -r p s; do
            echo "   $p -> $s"
        done
        echo ""
        echo "   CI 가 이 커밋을 받지 못해 images 워크플로가 죽는다."
        echo "   Fix: 해당 서브모듈에서 먼저 push 한 뒤 본체를 push"
        echo "        git -C <submodule> push"
        echo ""
        exit 1
    fi
done

# --- Check 4: 레이어/배선 게이트 (ADR-0083 / 0082 / Flyway) ---
# `check` 에 붙어 있지만 CI 도 로컬도 보통 `test` 만 돌린다 — Kotlin 이 섞인 push 에서만 직접 부른다.
# 개별 태스크가 아니라 묶음(verifyArchitecture)을 부른다 — 게이트를 새로 만들 때 호출부 추가를 잊지 않도록.
#
# **작업 트리가 아니라 푸시하는 커밋을 검사한다.** 작업 트리를 보면 두 가지가 샌다 —
#   ① 서브모듈을 고쳐 두고 포인터를 안 올린 커밋이 통과한다(2026-09-26: 위반 포인터 49e5a3f 가 올라가
#      CI verifyLayerDependencies 가 그 커밋의 이미지 전부를 막았다)
#   ② 공유 트리에서는 남의 미커밋 코드가 판정을 바꾼다
# 그래서 커밋을 임시 디렉토리에 풀고, 서브모듈도 그 커밋이 가리키는 포인터로 풀어 그곳에서 돈다(측정 ~13s).
if [ -n "$KT_TOUCHED" ] && [ -n "$PUSH_OID" ]; then
    echo "▶ 구조 게이트 (verifyArchitecture) — 푸시하는 커밋 ${PUSH_OID:0:8} 그대로"
    GATE_DIR=$(mktemp -d "${TMPDIR:-/tmp}/prepush-gate.XXXXXX")
    trap 'rm -rf "$GATE_DIR"' EXIT
    git archive "$PUSH_OID" | tar -x -C "$GATE_DIR"
    for sub_path in $SUB_PATHS; do
        sub_sha=$(git rev-parse "$PUSH_OID:$sub_path" 2>/dev/null) || continue
        [ -e "$sub_path/.git" ] || continue          # 체크아웃 안 된 서브모듈은 여기서 못 푼다
        mkdir -p "$GATE_DIR/$sub_path"
        if ! env -u GIT_DIR -u GIT_WORK_TREE git -C "$sub_path" archive "$sub_sha" 2>/dev/null | tar -x -C "$GATE_DIR/$sub_path"; then
            echo "❌ PUSH BLOCKED: 서브모듈 $sub_path 의 커밋 ${sub_sha:0:8} 을 로컬에서 찾을 수 없어 검사할 수 없다"
            echo "   Fix: git -C $sub_path fetch"
            exit 1
        fi
    done
    if ! ./gradlew -q -p "$GATE_DIR" verifyArchitecture; then
        echo ""
        echo "❌ PUSH BLOCKED: 구조 게이트 위반 (ADR-0083)"
        echo ""
        echo "   허용목록에 새 항목을 넣어 통과시키지 않는다 — 코드를 고친다."
        echo "   서브모듈을 고쳤다면 포인터를 올린 뒤 푸시한다(게이트는 커밋된 포인터를 본다)."
        echo "   표준: docs/conventions/package-structure.md · 체크리스트: docs/standards/new-domain-checklist.md"
        echo ""
        exit 1
    fi
fi

exit 0
