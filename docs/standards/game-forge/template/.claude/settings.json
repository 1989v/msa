{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(node forge/*)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(python3 *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(wc *)",
      "Bash(open *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/forge/session-start.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/forge/lint.mjs\"", "timeout": 15, "statusMessage": "game-forge lint" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/forge/stop-hook.mjs\"", "timeout": 30, "statusMessage": "game-forge 완성 게이트" }
        ]
      }
    ]
  }
}
