    <script type="application/ld+json" data-seo-multi>{"@context":"https://schema.org","@type":"VideoGame","name":"사태","description":"쏘면 파이고, 파인 것은 흘러내리고, 뜨거우면 바람이 솟는다. 흐르는 지형 위에서 삼국~조선의 무장이 순서대로 겨루는 턴제 포격 대전. 궁수는 기류를 읽고, 포수는 지형을 무너뜨리고, 검사는 검기로 땅을 갈라 산사태를 낸다. 화산재는 안식각까지 흘러내리고 용암은 굳으며, 산사태에 파묻히면 파내야 한다. 드래그로 조준해 놓으면 날아가고 직전 궤적이 점선으로 남는다. 봇과 연습하거나, 빠른 대전·코드 방·초대 링크로 사람과 1대1. 창병·방패병·팀전·아이템은 다음 단계.","url":"https://game.1989v.com/games/landslide","inLanguage":"ko","genre":"대전","keywords":"대전, versus, artillery, turn-based, physics, bot, 웹게임, 브라우저 게임","gamePlatform":"Web Browser","applicationCategory":"Game","operatingSystem":"Any","author":{"@type":"Person","@id":"https://1989v.com/#person","name":"권기덕"},"publisher":{"@type":"Organization","name":"1989v 게임","url":"https://game.1989v.com","founder":{"@type":"Person","@id":"https://1989v.com/#person","name":"권기덕"}},"offers":{"@type":"Offer","price":"0","priceCurrency":"KRW","availability":"https://schema.org/InStock"},"image":"https://game.1989v.com/games/thumbs/shots/landslide.jpg"}</script>
