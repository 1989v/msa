    <meta name="color-scheme" content="only light" />

    
    <script>
      (function () {
        var KEY = "kh-theme";
        function stored() {
          var hit = document.cookie.split("; ").find(function (c) {
            return c.indexOf(KEY + "=") === 0;
          });
          var v = hit && hit.slice(KEY.length + 1);
          if (v === "light" || v === "dark") return v;
          try {
            v = localStorage.getItem(KEY);
          } catch (e) {
            v = null;
          }
          return v === "light" || v === "dark" ? v : null;
        }
        var root = document.documentElement;
        var theme;
        // /tech 만 브랜드 면이 아니다 — dark-trading 팔레트를 전제로 그려진 화면이라 다크 고정.
        if (location.pathname === "/tech") {
          theme = "dark";
        } else {
          theme =
            stored() ||
            (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          root.setAttribute("data-surface", "heritage");
        }
        root.setAttribute("data-theme", theme);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "dark" ? "#131313" : "#f9f8f2");
        var scheme = document.querySelector('meta[name="color-scheme"]');
        if (scheme) scheme.setAttribute("content", "only " + theme);
      })();
    </script>

    
