    <script>
      (function () {
        var host = location.hostname;
        // 개발 중 클릭이 실제 리포트에 섞이면 유입 분석이 흐려진다
        if (host === "localhost" || host === "127.0.0.1") return;
        if (host.split(".")[0] === "resume") return;
        if (/^\/shared\//.test(location.pathname) || /%2Fshared%2F/i.test(location.search) || /^[a-z][a-z0-9+.-]*:\/\/[^\/?#]+\/shared\//i.test(document.referrer)) return;
        var id = "G-5EE8XW7JHN";
        var tag = document.createElement("script");
        tag.async = true;
        tag.src = "https://www.googletagmanager.com/gtag/js?id=" + id;
        document.head.appendChild(tag);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag("js", new Date());
        window.gtag("config", id);
      })();
    </script>

    

    
    <meta name="google-adsense-account" content="ca-pub-4627924728297793" />

    
    <meta name="theme-color" content="#0a0a0a" />

    
    <meta name="color-scheme" content="only light" />

    
    <script>
      (function () {
        var KEY = "kh-theme";
        function stored() {
          var hit = document.cookie.split("; ").find(function (c) {
            return c.indexOf(KEY + "=") === 0;
          });
          var v = hit && hit.slice(KEY.length + 1);
          if (v === "light" || v === "dark") return v;
          try {
            v = localStorage.getItem(KEY);
          } catch (e) {
            v = null;
          }
          return v === "light" || v === "dark" ? v : null;
        }
        var root = document.documentElement;
        var theme;
        // /tech 만 브랜드 면이 아니다 — dark-trading 팔레트를 전제로 그려진 화면이라 다크 고정.
        if (location.pathname === "/tech") {
          theme = "dark";
        } else {
          theme =
            stored() ||
            (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          root.setAttribute("data-surface", "heritage");
        }
        root.setAttribute("data-theme", theme);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "dark" ? "#131313" : "#f9f8f2");
        var scheme = document.querySelector('meta[name="color-scheme"]');
        if (scheme) scheme.setAttribute("content", "only " + theme);
      })();
    </script>

    
